  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": [
          "Montserrat",
          "Noto Sans Arabic",
          "Segoe UI",
          "system-ui",
          "sans-serif"
        ]
      },
      "serif": {
        "$value": [
          "Montserrat",
          "sans-serif"
        ],
        "$description": "No separate serif face is licensed for product UI; the required schema role aliases the approved UI family."
      },
      "mono": {
        "$value": [
          "IBM Plex Mono",
          "monospace"
        ]
      }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "0.75rem"
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem"
    }
  },
  "$extensions": {
    "com.ksap.cloud": {
      "version": "6.1",
      "provenance": "DESIGN.md sections 2–3.11. Palette anchors are exact source values; missing non-blue intermediate interaction shades are derived, not claimed as supplied implementation values.",
      "brand": {
        "vividBlue": "#0253E9",
        "darkBlue": "#010D43",
        "blueGray": "#43576C",
        "lightBlue": "#DEE9FF"
      },
      "palettes": {
